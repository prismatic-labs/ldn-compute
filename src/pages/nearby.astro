---
import BaseLayout from "../components/BaseLayout.astro";
import NearbyFinder from "../components/NearbyFinder";
import { getItemizedSites } from "../lib/sites";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sites = getItemizedSites(); // exclude campus overlays
---

<BaseLayout
  title="What's near you"
  description="Find the data centre schemes nearest a London postcode, filtered by size and build maturity, from sourced figures."
>
  <h1 class="font-display text-3xl m-0 tracking-tight">What's near you</h1>
  <p class="text-[var(--muted)] mt-2 max-w-2xl">
    Enter a postcode to see the data centre schemes closest to it. Set a minimum size or limit to what is
    running now versus still in the pipeline. Distances are straight-line to each site's mapped location.
  </p>

  <div class="mt-8">
    <NearbyFinder client:load sites={sites} baseUrl={base} />
  </div>

  <section id="have-your-say" class="mt-14 border-t border-[var(--line)] pt-8 max-w-2xl">
    <h2 class="font-display text-xl m-0 tracking-tight">Have your say</h2>
    <p class="text-sm text-[var(--muted)] mt-2">
      Found a scheme near you? Here is how to act on it.
    </p>
    <ol class="mt-4 space-y-3 text-sm list-none p-0 m-0">
      <li>
        <strong>Open its dossier.</strong> Use the finder above or the
        <a href={`${base}/`}>map</a>, then click through to the site’s page for its status, figures, and sources.
      </li>
      <li>
        <strong>Check the status.</strong> A site marked <em>in planning</em> or on appeal usually has a live
        window to comment; one that is already operating or consented may not.
      </li>
      <li>
        <strong>Comment on the application.</strong> Each dossier links to the council’s planning portal where
        one exists. Submit your comment there before the deadline. Councils weigh material planning
        considerations (traffic, noise, water, environment, design), so specific points land better than
        general objection.
      </li>
      <li>
        <strong>See the bigger picture.</strong> The <a href={`${base}/context`}>Context</a> page sets out the
        power, water, land, and noise pressures; contested sites also link their local campaign groups.
      </li>
    </ol>
    <p class="text-xs text-[var(--muted)] mt-4">
      Spotted a wrong figure or a missing site instead? That goes to <a href={`${base}/contribute`}>Contribute</a>.
    </p>
  </section>
</BaseLayout>
