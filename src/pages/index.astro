---
import BaseLayout from "../components/BaseLayout.astro";
import BrandLink from "../components/BrandLink.astro";
import SiteMap from "../components/SiteMap";
import { correctionsMailto } from "../lib/contact";
import { getConfig, getSites, getItemizedSites, regionalTotals, formatBestPower, siteBestPower } from "../lib/sites";
import { formatNumber } from "../lib/units";

const config = getConfig();
// Itemized halls only for the map and table. Campus "aggregate" dossiers stay
// reachable by URL but are never pinned or summed, so a campus is never
// double-counted against its own halls. regionalTotals gets the full set (it
// filters aggregates internally) so it can still report how many were folded.
const sites = getItemizedSites();
const totals = regionalTotals(getSites());
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const center = config.region.map.center as [number, number];
const lastUpdated = sites
  .map((s) => s.properties.last_reviewed)
  .sort()
  .at(-1);

// Headline stat for the map panel: running today vs still-to-be-built.
const PIPELINE_REALITY = new Set(["pipeline", "consented", "under_construction"]);
let operatingMw = 0;
let pipelineMw = 0;
for (const f of sites) {
  const best = siteBestPower(f.properties);
  if (!best) continue;
  const r = f.properties.operational_reality;
  if (r === "operating") operatingMw += best.quantity.value;
  else if (r && PIPELINE_REALITY.has(r)) pipelineMw += best.quantity.value;
}
const stat = `≈${formatNumber(operatingMw)} MW operating · ≈${formatNumber(pipelineMw)} MW proposed`;
---

<BaseLayout fullBleed description="Map of data centre sites across Greater London and the M25 fringe.">
  <h1 class="sr-only">
    The London Compute Ring: a map of data centre sites across Greater London and the M25 fringe
  </h1>
  <SiteMap
    client:idle
    sites={sites}
    stat={stat}
    baseUrl={base}
    center={center}
    zoom={config.region.map.zoom}
  />

  <section class="max-w-5xl mx-auto px-4 py-16">
    <h2 class="font-display text-2xl m-0 tracking-tight">Regional footprint</h2>
    <p class="text-[var(--muted)] mt-2 mb-6">
      {totals.count} sites · {totals.powerLabel} · {formatNumber(totals.acres)} acres of land take
      {totals.undisclosedPower > 0 && (
        <span> · {totals.undisclosedPower} with power not disclosed</span>
      )}
      {totals.aggregateCount > 0 && (
        <span> · {totals.aggregateCount} campus dossiers folded into their halls (not pinned or summed, to avoid double-counting)</span>
      )}
      {totals.decommissionedCount > 0 && (
        <span> · {totals.decommissionedCount} closed (shown on the map, not in totals)</span>
      )}
      . The “at least” symbol (≥) marks incomplete disclosure. Megawatts are stated size on paper
      (nameplate/contracted), not day-to-day regional electricity use.
      {lastUpdated && (
        <span class="block mt-1 text-xs">Map data last reviewed {lastUpdated}.</span>
      )}
    </p>

    <div class="mt-10 mb-12">
      <h3 class="font-display text-xl m-0 tracking-tight">How you might use this</h3>
      <p class="text-sm text-[var(--muted)] mt-1 mb-5 max-w-2xl">
        Three ways in. Each link goes to a tool already on the site.
      </p>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="border-t border-[var(--ink)] pt-3">
          <p class="m-0 text-xs uppercase tracking-wider text-[var(--muted)]">Journalists</p>
          <p class="m-0 mt-2 text-sm leading-snug">
            Check a scheme behind a story: every figure is sourced or blank, with the planning reference and objection window.
          </p>
          <p class="m-0 mt-3 text-sm">
            <a href={`${base}/research`}>Research checklist</a>
            <span class="text-[var(--muted)]"> · </span>
            <a href={`${base}/data/sites.geojson`}>Download GeoJSON</a>
          </p>
        </div>
        <div class="border-t border-[var(--ink)] pt-3">
          <p class="m-0 text-xs uppercase tracking-wider text-[var(--muted)]">Residents</p>
          <p class="m-0 mt-2 text-sm leading-snug">
            See what’s proposed or running near you, and how to have your say.
          </p>
          <p class="m-0 mt-3 text-sm">
            <a href={`${base}/nearby`}>Near you</a>
            <span class="text-[var(--muted)]"> · </span>
            <a href={`${base}/nearby#have-your-say`}>Have your say</a>
          </p>
        </div>
        <div class="border-t border-[var(--ink)] pt-3">
          <p class="m-0 text-xs uppercase tracking-wider text-[var(--muted)]">Researchers</p>
          <p class="m-0 mt-2 text-sm leading-snug">
            Open, sourced data. Download the GeoJSON and read how figures are chosen.
          </p>
          <p class="m-0 mt-3 text-sm">
            <a href={`${base}/data/sites.geojson`}>Download GeoJSON</a>
            <span class="text-[var(--muted)]"> · </span>
            <a href={`${base}/methodology`}>Methodology</a>
          </p>
        </div>
      </div>
    </div>

    <div class="mb-12 border border-[var(--line)] rounded-md px-4 py-4 sm:px-5">
      <p class="m-0 text-xs uppercase tracking-wider text-[var(--muted)]">Context</p>
      <p class="m-0 mt-2 font-display text-lg tracking-tight">
        Power, water, jobs, noise, and land, and how London compares with the US build-out.
      </p>
      <p class="m-0 mt-2 text-sm text-[var(--muted)] max-w-2xl">
        A sourced explainer of the pressures these sites put on grids and communities, with mitigations already
        appearing in London dossiers. Benefits sit next to costs.
      </p>
      <p class="m-0 mt-3 text-sm">
        <a href={`${base}/context`}>Read the context →</a>
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-[var(--line)] text-left text-[var(--muted)]">
            <th class="py-2 font-medium">Site</th>
            <th class="py-2 font-medium">Status</th>
            <th class="py-2 font-medium">Stated size</th>
            <th class="py-2 font-medium">Site area</th>
          </tr>
        </thead>
        <tbody>
          {sites.map((f) => (
            <tr class="border-b border-[var(--line)]">
              <td class="py-2"><a href={`${base}/site/${f.properties.id}`}>{f.properties.name}</a></td>
              <td class="py-2 capitalize">{f.properties.status.replaceAll("_", " ")}</td>
              <td class="py-2 font-tabular">{formatBestPower(f.properties)}</td>
              <td class="py-2 font-tabular">
                {f.properties.land.acres
                  ? `${formatNumber(f.properties.land.acres.value)} acres`
                  : "Unknown"}
                {" · "}
                {f.properties.land.land_type === "brownfield"
                  ? "brownfield"
                  : f.properties.land.land_type === "agricultural"
                    ? "farmland"
                    : "industrial"}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-8 mb-0 flex flex-wrap gap-4 text-sm">
      <a href={`${base}/sites`}>Full sortable table</a>
      <a href={`${base}/compare`}>Compare view</a>
      <a href={`${base}/context`}>Context</a>
      <a href={`${base}/research`}>Research log</a>
      <a href={`${base}/methodology`}>Methodology</a>
    </p>
  </section>

  <footer class="border-t border-[var(--line)] py-8 text-sm text-[var(--muted)]">
    <div class="max-w-5xl mx-auto px-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="m-0">
          <span class="wordmark text-[var(--muted)]">{config.site_name}</span>
        </p>
        <p class="m-0 mt-2">
          Corrections: <a href={correctionsMailto()}>{config.contact.corrections_email}</a>.
          Opens with subject “London Compute Ring: correction”.
        </p>
      </div>
      <BrandLink />
    </div>
  </footer>
</BaseLayout>
