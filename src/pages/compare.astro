---
import BaseLayout from "../components/BaseLayout.astro";
import CompareView from "../components/CompareView";
import { getItemizedSites } from "../lib/sites";

// Itemized halls only; campus overlays are excluded so they never rank beside their halls.
const sites = getItemizedSites();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteUrl = (Astro.site?.toString().replace(/\/$/, "") ?? "https://prismatic-labs.github.io") + base;
---

<BaseLayout
  title="Compare"
  description="Side-by-side comparison of the power footprint of data centres across Greater London and the M25 fringe."
>
  <h1 class="font-display text-3xl m-0 tracking-tight">Compare power</h1>
  <p class="text-[var(--muted)] mt-2 max-w-2xl">
    How large is each proposal’s claimed draw on the grid relative to the others?
    Circles use true area scale (twice the megawatts looks twice as large). Figures are stated
    power size on paper, not how much electricity a site will draw day to day.
  </p>
  <div class="mt-8">
    <CompareView client:load sites={sites} baseUrl={base} siteUrl={siteUrl} />
  </div>
</BaseLayout>
