---
import BaseLayout from "../components/BaseLayout.astro";
import { getConfig } from "../lib/sites";
import { correctionsMailto } from "../lib/contact";

const config = getConfig();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const issues = config.contact.github_issues;

const routes = [
  {
    title: "Correct a figure or status",
    body: "A megawatt number, a planning status, a source that has moved or is wrong. Point to the site and the evidence.",
    mailto: correctionsMailto({ kind: "correction" }),
    cta: "Email a correction",
  },
  {
    title: "Suggest a site we are missing",
    body: "A scheme that changes the planning, land, or grid picture and is not on the map. A planning reference or news link helps.",
    mailto: correctionsMailto({ kind: "new-site" }),
    cta: "Email a new site",
  },
  {
    title: "Right of reply",
    body: "If you operate or represent a site here and want to respond to a figure or claim, we publish operator responses verbatim.",
    mailto: correctionsMailto({ kind: "right-of-reply" }),
    cta: "Send a response",
  },
];
---

<BaseLayout
  title="Contribute"
  description="Send a correction, a missing site, or an operator right of reply. Everything is reviewed before publication; the public never writes the data directly."
>
  <h1 class="font-display text-3xl m-0 tracking-tight">Contribute</h1>
  <p class="text-[var(--muted)] mt-2 max-w-2xl">
    This map is public and sourced. Corrections, missing sites, and operator responses are welcome.
    Everything goes through review before it is published; nothing you send writes the data directly.
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    {routes.map((r) => (
      <div class="border border-[var(--line)] rounded p-4 flex flex-col">
        <h2 class="font-display text-lg m-0">{r.title}</h2>
        <p class="text-sm text-[var(--muted)] mt-1 flex-1">{r.body}</p>
        <a
          href={r.mailto}
          class="mt-3 inline-block border border-[var(--ink)] rounded px-3 py-1.5 text-sm no-underline hover:bg-[var(--ink)] hover:text-[var(--paper)] transition-colors self-start"
        >
          {r.cta}
        </a>
      </div>
    ))}
  </div>

  <section class="mt-10 max-w-2xl">
    <h2 class="font-display text-lg m-0">What makes a report we can use</h2>
    <ul class="mt-2 text-sm text-[var(--muted)] space-y-1">
      <li>The site (its name or the URL of its page here).</li>
      <li>What should change, in one or two lines.</li>
      <li>Evidence: a planning document and page, an operator datasheet, a metered figure, or a news source. A figure with no source stays out.</li>
    </ul>
    <p class="text-sm text-[var(--muted)] mt-3">
      Prefer GitHub? Use the <a href={issues}>issue forms</a> for corrections and new sites.
      Water figures are the disclosure we most want — see <a href={`${base}/methodology#water`}>on water</a>.
    </p>
  </section>
</BaseLayout>
